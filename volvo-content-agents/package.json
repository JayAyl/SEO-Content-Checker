{
  "name": "volvo-content-agents",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/check.mjs",
    "lint": "html-validate \"outputs/.build/*.html\"",
    "w3c": "java -jar node_modules/vnu-jar/build/dist/vnu.jar --Werror --skip-non-html outputs/.build",
    "test": "npm run check && npm run lint && npm run w3c"
  },
  "devDependencies": {
    "html-validate": "8.18.2",
    "vnu-jar": "23.4.11"
  }
}
